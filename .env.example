# Supabase (Project Settings > API); used only on the server
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI platforms: each one is scanned only when its key is set
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Writes (add business, edit facts, run scans) are off unless this is "true".
# Set it locally; leave it unset on the public deployment.
NEXT_PUBLIC_ALLOW_WRITES=true
